% ==============================================================================
% Fichier     : Style_Devoir.sty
% Description : Style Institutionnel ENSPY
%               Texte Noir & Accents Bleu Canard / Doré
%               Inclut la commande \MakeTitleENSPY
% Version     : 4.0 — 2026
% ==============================================================================
\ProvidesPackage{Style_Devoir}[2026/03/19 v4.0 Style ENSPY complet]

% --------------------------------------------------------------------------
% PACKAGES DE BASE
% --------------------------------------------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[french]{babel}
\RequirePackage{lmodern}
\RequirePackage[top=2.5cm, bottom=2.5cm, left=2.5cm, right=2.5cm]{geometry}
\RequirePackage[dvipsnames, table]{xcolor}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage[most]{tcolorbox}
\RequirePackage{setspace}
\RequirePackage{tikz}
\RequirePackage{graphicx}
\RequirePackage{array}
\usetikzlibrary{calc, shadings}

% --------------------------------------------------------------------------
% PALETTE DE COULEURS
% --------------------------------------------------------------------------
\definecolor{bleucanard}{RGB}{0, 102, 102}
\definecolor{doré}{RGB}{212, 175, 55}
\definecolor{FondGris}{RGB}{248, 249, 250}
\definecolor{OrangeENSPY}{RGB}{230, 115, 0}
\definecolor{BleuPetrole}{RGB}{29, 72, 81}
\definecolor{BleuCiel}{RGB}{173, 216, 230}
\definecolor{Noir}{RGB}{0, 0, 0}

% --------------------------------------------------------------------------
% CONFIGURATION TYPOGRAPHIQUE
% --------------------------------------------------------------------------
\setstretch{1.2}
\color{black}

% --------------------------------------------------------------------------
% FILET DÉGRADÉ (s'efface vers la droite)
% --------------------------------------------------------------------------
\newcommand{\degradeRule}[2]{%
  \begin{tikzpicture}
    \shade[left color=#1, right color=white]
      (0,0) rectangle (\linewidth, #2);
  \end{tikzpicture}%
}

% --------------------------------------------------------------------------
% STYLE DES SECTIONS
% --------------------------------------------------------------------------
\titleformat{\section}
    {\color{bleucanard}\Large\bfseries}
    {\thesection.}{0.5em}{}
    [{\degradeRule{bleucanard}{1.5pt}}]      % ← dégradé bleu canard
\titlespacing*{\section}{0pt}{3.5ex plus 1ex minus .2ex}{2ex plus .2ex}

\titleformat{\subsection}
    {\color{bleucanard}\large\bfseries}
    {\thesubsection}{0.7em}{}
    [{\degradeRule{doré}{1pt}}]              % ← dégradé doré
\titlespacing*{\subsection}{0pt}{2.5ex plus 1ex minus .2ex}{1.5ex plus .2ex}

\titleformat{\subsubsection}
    {\color{bleucanard}\normalsize\bfseries}
    {\thesubsubsection}{0.7em}{}
    [{\degradeRule{bleucanard}{0.8pt}}]      % ← dégradé bleu canard fin
\titlespacing*{\subsubsection}{0pt}{2ex plus .5ex minus .2ex}{1ex plus .2ex}

% --------------------------------------------------------------------------
% BOÎTE QUALITY GATE
% --------------------------------------------------------------------------
\newtcolorbox{qgbox}[1]{
    enhanced, breakable,
    colback=FondGris, colframe=bleucanard,
    arc=0pt, outer arc=0pt, boxrule=0.5pt, leftrule=5pt,
    fonttitle=\bfseries\sffamily, coltitle=doré,
    title={\tikz[baseline=-0.6ex]\draw[fill=doré, draw=none] circle (0.4em);\space Quality Gate : #1},
    attach title to upper, after title={\par\medskip},
    before skip=25pt, after skip=25pt,
    fontupper=\small\color{black}
}

% --------------------------------------------------------------------------
% BOÎTE REMARQUE
% --------------------------------------------------------------------------
\newtcolorbox{remarquebox}[1][Remarque]{
    enhanced, breakable,
    colback=FondGris, colframe=bleucanard,
    arc=3pt, outer arc=3pt, boxrule=0.5pt, leftrule=4pt,
    fonttitle=\bfseries\sffamily\small, coltitle=bleucanard,
    title={\tikz[baseline=-0.6ex]\draw[fill=bleucanard, draw=none] circle (0.4em);\space #1},
    attach title to upper, after title={\par\smallskip},
    before skip=15pt, after skip=15pt,
    fontupper=\small\color{black}
}

% --------------------------------------------------------------------------
% BOÎTE DÉFINITION
% --------------------------------------------------------------------------
\newtcolorbox{definitionbox}[1][Définition]{
    enhanced, breakable,
    colback=FondGris, colframe=doré,
    arc=3pt, outer arc=3pt, boxrule=0.5pt, leftrule=4pt,
    fonttitle=\bfseries\sffamily\small, coltitle=doré,
    title={\tikz[baseline=-0.6ex]\draw[fill=doré, draw=none] circle (0.4em);\space #1},
    attach title to upper, after title={\par\smallskip},
    before skip=15pt, after skip=15pt,
    fontupper=\small\color{black}
}

% --------------------------------------------------------------------------
% LISTES
% --------------------------------------------------------------------------
\setlist[itemize]{label=\color{doré}$\bullet$, itemsep=0.8ex}
\setlist[enumerate]{label=\color{bleucanard}\textbf{\arabic*.}, itemsep=0.8ex}

% --------------------------------------------------------------------------
% HYPERLIENS
% --------------------------------------------------------------------------
\RequirePackage[colorlinks=true, linkcolor=bleucanard,
                urlcolor=doré, citecolor=bleucanard]{hyperref}

% --------------------------------------------------------------------------
% VARIABLES DE LA PAGE DE TITRE
% --------------------------------------------------------------------------
