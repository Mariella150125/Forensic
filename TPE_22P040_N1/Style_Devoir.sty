\newcommand{\sousTitre}[1]{\def\@sousTitre{#1}}
\newcommand{\optionEtude}[1]{\def\@optionEtude{#1}}
\newcommand{\auteur}[1]{\def\@auteur{#1}}
\newcommand{\encadrant}[1]{\def\@encadrant{#1}}
\newcommand{\anneeAcad}[1]{\def\@anneeAcad{#1}}
\newcommand{\logoenspy}[1]{\def\@logoenspy{#1}}

% Valeurs par défaut
\def\@titreTravaux{TECHNIQUES D'INVESTIGATION NUMÉRIQUE AVANCÉES}
\def\@sousTitre{RÉSUMÉ DU PIU}
\def\@optionEtude{Cybersécurité et Investigation Numérique}
